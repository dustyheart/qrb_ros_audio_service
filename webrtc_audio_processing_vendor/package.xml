<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>webrtc_audio_processing_vendor</name>
  <version>1.3.0</version>
  <description>
    Vendored freedesktop.org webrtc-audio-processing 1.3 (WebRTC AEC3 echo cancellation,
    noise suppression, VAD) for the qrb_audio_common_lib capture processors. Installs
    libwebrtc-audio-processing-1 with its headers and pkg-config file.
  </description>
  <maintainer email="hangshen@qti.qualcomm.com">hangshen</maintainer>
  <!-- License of the vendored library (webrtc-audio-processing, BSD-3-Clause). -->
  <license>BSD-3-Clause</license>

  <url type="website">https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>meson</buildtool_depend>
  <buildtool_depend>ninja-build</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>libabsl-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
